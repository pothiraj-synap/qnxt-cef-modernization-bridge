{
  "name": "QNXT-CEF-Modernization-Workspace",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20"
    },
    // Senior Infrastructure Mapping: Automatically spins up and mounts an isolated, 
    // lightweight PostgreSQL engine right inside your Linux cloud workspace container.
    "ghcr.io/devcontainers/features/postgres:1": {
      "version": "16",
      "password": "CefSecurePassword123!",
      "database": "qnxt_cef_modernization"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-mssql.mssql",
        "ckearneg.bicep"
      ]
    }
  },
  "forwardPorts": [3000, 5432], // Opens up the API, React UI, and DB ports cleanly
  "postCreateCommand": "dotnet restore"
}
