{
  "name": "QNXT-CEF-Modernization-Workspace",
  // "dockerComposeFile": "docker-compose.yml",
  // "service": "app",
  // "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/dotnet",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20"
    },
    // Senior Infrastructure Mapping: Automatically spins up and mounts an isolated, 
    // lightweight PostgreSQL engine right inside your Linux cloud workspace container.
    // "ghcr.io/devcontainers/features/postgres:1": {
    //   "version": "16",
    //   "password": "CefSecurePassword123!",
    //   "database": "qnxt_cef_modernization"
    // }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-mssql.mssql",
        "ckearneg.bicep",
        "ms-azuretools.vscode-bicep"
      ]
    }
  },
  "forwardPorts": [3000, 5432], // Opens up the API, React UI, and DB ports cleanly
  //"postCreateCommand": "dotnet restore",
   "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql && sudo service postgresql start && sudo -u postgres psql -c \"ALTER USER postgres WITH PASSWORD 'CefSecurePassword123!';\" && sudo -u postgres createdb qnxt_cef_modernization && dotnet restore QnxtCefModernization.slnx",
  "postStartCommand": "sudo service postgresql start"
}
